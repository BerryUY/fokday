# Neon → Dashboard → tu proyecto → Connect → "Connection string" (con ?sslmode=require)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Código de invitación: se lo pasás a la gente que querés que use la app (mínimo 8 caracteres).
# Sin este código nadie puede crear un perfil. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
INVITE_CODE=
# Cuántos perfiles acepta este servidor (por defecto 50) y cuántas versiones guarda cada perfil (por defecto 60).
MAX_PROFILES=50
MAX_BACKUPS=60
