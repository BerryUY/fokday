# Neon → Dashboard → tu proyecto → Connect → "Connection string" (con ?sslmode=require)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Token personal: generalo con `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
MOMENTUM_API_TOKEN=
# Cuántas versiones guardar (las más viejas se borran). Opcional, por defecto 60.
MAX_BACKUPS=60
